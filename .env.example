# ==============================================================================
# Variables d'environnement pour GRC-as-Code
# ==============================================================================
# Copiez ce fichier sous le nom .env pour personnaliser votre configuration locale :
#   cp .env.example .env
#
# ATTENTION : Les identifiants par defaut sont strictement reserves a la demo locale.
# ==============================================================================

# Base de donnees PostgreSQL
# Dans docker-compose, l'hote est 'postgres'. Hors Docker, utiliser 'localhost' (port 5435).
DATABASE_URL=postgresql+psycopg2://grc_user:grc_password@postgres:5432/grc_db

# Integration Jira Cloud (requis uniquement pour `grc export-jira --no-dry-run`)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SEC
